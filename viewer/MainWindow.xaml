<Window
    x:Class="Backpack.Viewer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Backpack.Viewer.Views">

  <Window.SystemBackdrop>
    <DesktopAcrylicBackdrop />
  </Window.SystemBackdrop>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="44" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid x:Name="TitleBarArea" Grid.Row="0">
      <TextBlock
          x:Name="AppTitleText"
          Margin="52,0,0,0"
          Style="{StaticResource AppCaptionTextBlockStyle}"
          VerticalAlignment="Center" />
    </Grid>

    <NavigationView
        x:Name="NavView"
        Grid.Row="1"
        FontFamily="{StaticResource AppFontFamily}"
        CompactPaneLength="48"
        OpenPaneLength="200"
        PaneDisplayMode="Left"
        IsBackButtonVisible="Collapsed"
        IsPaneToggleButtonVisible="True"
        SelectionChanged="OnNavSelectionChanged">

      <NavigationView.Resources>
        <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
        <Thickness x:Key="NavigationViewContentMargin">0</Thickness>
        <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
      </NavigationView.Resources>

      <NavigationView.MenuItems>
        <NavigationViewItem x:Name="NavWeapon"   x:Uid="NavWeapon">
          <NavigationViewItem.Icon>
            <BitmapIcon ShowAsMonochrome="False" UriSource="ms-appx:///Assets/Nav_Weapon.png" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Name="NavAvatar"   x:Uid="NavAvatar">
          <NavigationViewItem.Icon>
            <BitmapIcon ShowAsMonochrome="False" UriSource="ms-appx:///Assets/Nav_Avatar.png" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Name="NavArtifact" x:Uid="NavArtifact">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE77B;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItemHeader x:Uid="NavHeaderData" />
        <NavigationViewItem x:Name="NavMaterial" x:Uid="NavMaterial">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE8F1;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Name="NavFood"     x:Uid="NavFood">
          <NavigationViewItem.Icon>
            <BitmapIcon ShowAsMonochrome="False" UriSource="ms-appx:///Assets/Nav_Food.png" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Name="NavGadget"   x:Uid="NavGadget">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE74C;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Name="NavAsset"    x:Uid="NavAsset">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE8B9;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>

      <NavigationView.FooterMenuItems />

      <Grid>
        <ProgressRing
            Width="48"
            Height="48"
            IsActive="{x:Bind ViewModel.IsLaunching, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.ProgressRingVisibility, Mode=OneWay}" />

        <views:SetupPage
            x:Name="SetupPageControl"
            ViewModel="{x:Bind ViewModel}"
            Visibility="{x:Bind ViewModel.SetupVisibility, Mode=OneWay}" />

        <Grid Visibility="{x:Bind ViewModel.DataVisibility, Mode=OneWay}">
          <views:WeaponPage
              x:Name="PageWeapon"
              WeaponGroups="{x:Bind ViewModel.WeaponGroups}"
              Visibility="Collapsed" />
          <views:AvatarPage
              x:Name="PageAvatar"
              Avatars="{x:Bind ViewModel.Avatars}"
              Visibility="Collapsed" />
          <views:ArtifactPage
              x:Name="PageArtifact"
              ArtifactGroups="{x:Bind ViewModel.ArtifactGroups}"
              Visibility="Collapsed" />
          <views:MaterialPage
              x:Name="PageMaterial"
              MaterialGroups="{x:Bind ViewModel.MaterialGroups}"
              Visibility="Collapsed" />
          <views:FoodPage
              x:Name="PageFood"
              FoodGroups="{x:Bind ViewModel.FoodGroups}"
              Visibility="Collapsed" />
          <views:GadgetPage
              x:Name="PageGadget"
              GadgetGroups="{x:Bind ViewModel.GadgetGroups}"
              Visibility="Collapsed" />
          <views:AssetPage
              x:Name="PageAsset"
              AssetGroups="{x:Bind ViewModel.AssetGroups}"
              Visibility="Collapsed" />
        </Grid>
      </Grid>

    </NavigationView>

  </Grid>

</Window>
