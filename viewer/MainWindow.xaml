<Window
    x:Class="Backpack.Viewer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Backpack.Viewer.Views">

  <Window.SystemBackdrop>
    <DesktopAcrylicBackdrop />
  </Window.SystemBackdrop>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="44" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid x:Name="TitleBarArea" Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock
          x:Name="AppTitleText"
          Grid.Column="0"
          Margin="52,0,0,0"
          Style="{StaticResource AppCaptionTextBlockStyle}"
          VerticalAlignment="Center" />

      <Border
          x:Name="TitleBarDragRegion"
          Grid.Column="1"
          Background="Transparent" />

      <StackPanel
          Grid.Column="2"
          Margin="0,0,180,0"
          Orientation="Horizontal"
          Spacing="8">
        <Button
            x:Name="ExportButton"
            Padding="16,6"
            VerticalAlignment="Center"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Click="OnExportMaterial"
            CornerRadius="{ThemeResource ControlCornerRadius}"
            Visibility="Collapsed">
          <StackPanel
              Orientation="Horizontal"
              Spacing="8">
            <FontIcon
                FontSize="14"
                Glyph="&#xE74E;" />
            <TextBlock
                x:Uid="MaterialExportButton"
                FontFamily="{StaticResource AppFontFamily}"
                VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button
            x:Name="SyncButton"
            Padding="16,6"
            VerticalAlignment="Center"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Click="OnToggleDrawer"
            CornerRadius="{ThemeResource ControlCornerRadius}"
            Visibility="{x:Bind ViewModel.LaunchButtonVisibility, Mode=OneWay}">
          <TextBlock
              x:Uid="SyncBagButton"
              FontFamily="{StaticResource AppFontFamily}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center" />
        </Button>
      </StackPanel>
    </Grid>

    <NavigationView
        x:Name="NavView"
        Grid.Row="1"
        FontFamily="{StaticResource AppFontFamily}"
        CompactPaneLength="64"
        OpenPaneLength="200"
        PaneDisplayMode="Left"
        IsBackButtonVisible="Collapsed"
        IsPaneToggleButtonVisible="True"
        IsPaneVisible="{x:Bind ViewModel.HasSelectedPath, Mode=OneWay}"
        SelectionChanged="OnNavSelectionChanged">

      <NavigationView.Resources>
        <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
        <Thickness x:Key="NavigationViewContentMargin">0</Thickness>
        <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
      </NavigationView.Resources>

      <NavigationView.MenuItems>
        <NavigationViewItem x:Name="NavWeapon"   x:Uid="NavWeapon" />
        <NavigationViewItem x:Name="NavAvatar"   x:Uid="NavAvatar" />
        <NavigationViewItem x:Name="NavArtifact" x:Uid="NavArtifact" />
        <NavigationViewItem x:Name="NavMonster"  x:Uid="NavMonster" />
        <NavigationViewItem x:Name="NavMaterial" x:Uid="NavMaterial" />
        <NavigationViewItem x:Name="NavFood"     x:Uid="NavFood" />
        <NavigationViewItem x:Name="NavGadget"   x:Uid="NavGadget" />
        <NavigationViewItem x:Name="NavAsset"    x:Uid="NavAsset" />
      </NavigationView.MenuItems>

      <NavigationView.FooterMenuItems />

      <Grid>
        <ProgressRing
            Width="48"
            Height="48"
            IsActive="{x:Bind ViewModel.IsLaunching, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.ProgressRingVisibility, Mode=OneWay}" />

        <views:SetupPage
            x:Name="SetupPageControl"
            ViewModel="{x:Bind ViewModel}"
            Visibility="{x:Bind ViewModel.SetupVisibility, Mode=OneWay}" />

        <Grid Visibility="{x:Bind ViewModel.DataVisibility, Mode=OneWay}">
          <views:WeaponPage
              x:Name="PageWeapon"
              WeaponGroups="{x:Bind ViewModel.WeaponGroups}"
              Visibility="Collapsed" />
          <views:AvatarPage
              x:Name="PageAvatar"
              Avatars="{x:Bind ViewModel.Avatars}"
              Visibility="Collapsed" />
          <views:ArtifactPage
              x:Name="PageArtifact"
              Artifacts="{x:Bind ViewModel.Artifacts}"
              Visibility="Collapsed" />
          <views:MonsterPage
              x:Name="PageMonster"
              Monsters="{x:Bind ViewModel.Monsters}"
              Visibility="Collapsed" />
          <views:MaterialPage
              x:Name="PageMaterial"
              MaterialGroups="{x:Bind ViewModel.MaterialGroups}"
              Visibility="Collapsed" />
          <views:FoodPage
              x:Name="PageFood"
              FoodGroups="{x:Bind ViewModel.FoodGroups}"
              Visibility="Collapsed" />
          <views:GadgetPage
              x:Name="PageGadget"
              GadgetGroups="{x:Bind ViewModel.GadgetGroups}"
              Visibility="Collapsed" />
          <views:AssetPage
              x:Name="PageAsset"
              AssetGroups="{x:Bind ViewModel.AssetGroups}"
              Visibility="Collapsed" />
        </Grid>
      </Grid>

    </NavigationView>

    <Grid
        x:Name="DrawerScrim"
        Grid.RowSpan="2"
        Background="#40000000"
        Tapped="OnScrimTapped"
        Visibility="Collapsed" />

    <Grid
        x:Name="DrawerHost"
        Grid.RowSpan="2"
        Width="400"
        HorizontalAlignment="Right"
        Visibility="Collapsed">
      <Grid.RenderTransform>
        <TranslateTransform x:Name="DrawerSlide" X="400" />
      </Grid.RenderTransform>
      <Border Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
        <ScrollViewer Padding="16,52,16,16" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12">
            <Border Padding="16" Style="{StaticResource BorderCardStyle}">
              <StackPanel Spacing="10">
                <Button
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Click="OnSyncBag"
                    IsEnabled="{x:Bind ViewModel.HasSelectedPath, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon FontSize="16" Glyph="&#xE7FC;" />
                    <TextBlock x:Uid="DrawerSyncText" FontFamily="{StaticResource AppFontFamily}" />
                  </StackPanel>
                </Button>
                <Button
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Click="OnKillGame"
                    IsEnabled="{x:Bind ViewModel.IsGameRunning, Mode=OneWay}">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon FontSize="16" Glyph="&#xE733;" />
                    <TextBlock x:Uid="DrawerKillText" FontFamily="{StaticResource AppFontFamily}" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>

            <Border Padding="16" Style="{StaticResource BorderShimmerStyle}">
              <StackPanel Spacing="4">
                <TextBlock
                    x:Uid="DrawerStatusLabel"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource AppCaptionTextBlockStyle}" />
                <TextBlock
                    FontFamily="{StaticResource AppFontFamily}"
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                    TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Padding="16" Style="{StaticResource BorderShimmerStyle}">
              <StackPanel Spacing="8">
                <TextBlock
                    x:Uid="DrawerPathLabel"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource AppCaptionTextBlockStyle}" />
                <TextBlock
                    FontFamily="{StaticResource AppFontFamily}"
                    Text="{x:Bind ViewModel.GamePathService.SelectedPath, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <Button HorizontalAlignment="Left" Click="OnDrawerPickPath">
                  <TextBlock x:Uid="DrawerSwitchPathText" FontFamily="{StaticResource AppFontFamily}" />
                </Button>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

  </Grid>

</Window>
