<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style x:Key="BorderCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
  </Style>

  <Style x:Key="BorderShimmerStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource ControlAltFillColorSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
  </Style>

  <Style x:Key="AcrylicBorderCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource SystemControlAcrylicElementBrush}" />
    <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
  </Style>

  <Style x:Key="AcrylicSecondaryBorderCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource SystemControlAcrylicWindowBrush}" />
    <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
  </Style>

  <Style
      x:Key="LargeGridViewItemStyle"
      BasedOn="{StaticResource DefaultGridViewItemStyle}"
      TargetType="GridViewItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Margin" Value="0,0,12,12" />
  </Style>

</ResourceDictionary>
