<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Backpack.Viewer</RootNamespace>
    <AssemblyName>BackpackViewer</AssemblyName>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <DefaultLanguage>en-US</DefaultLanguage>
    <SatelliteResourceLanguages>zh-CN;en-US</SatelliteResourceLanguages>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <DebugType>none</DebugType>
    <LangVersion>preview</LangVersion>
    <NoWarn>$(NoWarn);MVVMTK0045;NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\Fonts\*.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Weapon\weapons.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Weapon\weapon_curves.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Weapon\weapon_promotes.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Weapon\weapon_extra.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Artifact\artifacts.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Artifact\artifact_main_props.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Material\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Food\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Gadget\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Asset\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Avatar\avatar_meta.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Monster\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\HyperLinkName.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\AvatarDetail\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\logo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\logo.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Quality\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\UI\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\UI_Icon_Locked.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\UI_Icon_Fetter.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\UI_IconKira.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\UI_GachaShowPanel_Bg_Weapon.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Nav_Weapon.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Nav_Avatar.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Nav_Food.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\badge\*.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Styles\PivotStyle.xaml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Styles\Controls.xaml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\src\x64\Release\backpack.dll" CopyToOutputDirectory="PreserveNewest" Link="modules\backpack.dll" Condition="Exists('..\src\x64\Release\backpack.dll')" />
  </ItemGroup>

  <ItemGroup>
    <PRIResource Include="Strings\**\*.resw" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Strings\en-US\Resources.resw" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Primitives" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Media" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SourceGeneration\Backpack.Viewer.SourceGeneration.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      SetPlatform="Platform=AnyCPU" />
  </ItemGroup>

  <Target Name="RemoveUnusedLanguages" AfterTargets="Build">
    <Exec Command="for /d %%d in (&quot;$(OutDir)*&quot;) do if /I not &quot;%%~nxd&quot;==&quot;zh-CN&quot; if /I not &quot;%%~nxd&quot;==&quot;en-us&quot; if /I not &quot;%%~nxd&quot;==&quot;Assets&quot; if /I not &quot;%%~nxd&quot;==&quot;Styles&quot; if /I not &quot;%%~nxd&quot;==&quot;Microsoft.UI.Xaml&quot; if /I not &quot;%%~nxd&quot;==&quot;runtimes&quot; if /I not &quot;%%~nxd&quot;==&quot;modules&quot; rd /s /q &quot;%%d&quot;" />
  </Target>

  <Target Name="RemoveUnusedLanguagesFromPublish" AfterTargets="Publish">
    <Exec Command="for /d %%d in (&quot;$(PublishDir)*&quot;) do if /I not &quot;%%~nxd&quot;==&quot;zh-CN&quot; if /I not &quot;%%~nxd&quot;==&quot;en-us&quot; if /I not &quot;%%~nxd&quot;==&quot;Assets&quot; if /I not &quot;%%~nxd&quot;==&quot;Styles&quot; if /I not &quot;%%~nxd&quot;==&quot;Microsoft.UI.Xaml&quot; if /I not &quot;%%~nxd&quot;==&quot;runtimes&quot; if /I not &quot;%%~nxd&quot;==&quot;modules&quot; if /I not &quot;%%~nxd&quot;==&quot;data&quot; rd /s /q &quot;%%d&quot;" />
  </Target>

  <Target Name="IncludePriInPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(OutDir)$(AssemblyName).pri" RelativePath="$(AssemblyName).pri" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <Target Name="GenerateVersionConstants" BeforeTargets="MarkupCompilePass1;CoreCompile">
    <ItemGroup>
      <_VLine Include="// &lt;auto-generated/&gt;" />
      <_VLine Include="namespace Backpack.Viewer%3B" />
      <_VLine Include="internal static class AppVersion { public const string Value = &quot;$(Version)&quot;%3B }" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)AppVersion.g.cs" Lines="@(_VLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)AppVersion.g.cs" />
    </ItemGroup>
  </Target>

</Project>
