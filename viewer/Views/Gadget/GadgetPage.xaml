<UserControl
    x:Class="Backpack.Viewer.Views.GadgetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:ast="using:Backpack.Viewer.Views.Controls.AutoSuggestBox"
    xmlns:ctrl="using:Backpack.Viewer.Views.Controls"
    xmlns:vm="using:Backpack.Viewer.ViewModels">

  <UserControl.Resources>
    <DataTemplate x:Key="SimpleCardTemplate">
      <Grid Padding="10,8" Style="{ThemeResource GridShimmerStyle}" ColumnSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Width="40" Height="40" VerticalAlignment="Center" CornerRadius="6">
          <Image Source="{Binding QualitySource}" Stretch="Fill" />
          <Image Source="ms-appx:///Assets/Quality/UI_ImgSign_ItemIcon.png" Stretch="Fill" />
          <Image Source="{Binding IconSource}" Stretch="Uniform" />
        </Grid>
        <TextBlock
            Grid.Column="1"
            Style="{StaticResource AppBodyTextBlockStyle}"
            Text="{Binding Name}"
            TextTrimming="CharacterEllipsis"
            VerticalAlignment="Center" />
        <TextBlock
            Grid.Column="2"
            MinWidth="40"
            Style="{StaticResource AppBodyStrongTextBlockStyle}"
            Text="{Binding Count}"
            TextAlignment="Right"
            VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="SimpleGridTemplate">
      <ctrl:VerticalCard Width="82">
        <ctrl:VerticalCard.Top>
          <ctrl:ItemIcon
              Icon="{Binding IconSource}"
              Quality="{Binding QualitySource}" />
        </ctrl:VerticalCard.Top>
        <ctrl:VerticalCard.Bottom>
          <StackPanel>
            <TextBlock
                Margin="2,0"
                MaxWidth="74"
                HorizontalAlignment="Center"
                Style="{StaticResource AppCaptionTextBlockStyle}"
                Text="{Binding Name}"
                TextAlignment="Center"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap"
                ToolTipService.ToolTip="{Binding Name}" />
            <TextBlock
                Margin="2,0"
                HorizontalAlignment="Center"
                Opacity="0.7"
                Style="{StaticResource AppCaptionTextBlockStyle}"
                Text="{Binding Count}" />
          </StackPanel>
        </ctrl:VerticalCard.Bottom>
      </ctrl:VerticalCard>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="auto" />
      <RowDefinition />
    </Grid.RowDefinitions>

    <Border Margin="16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
      <Border Style="{StaticResource AcrylicSecondaryBorderCardStyle}">
        <CommandBar
            BorderBrush="{x:Null}"
            BorderThickness="0"
            DefaultLabelPosition="Right">
          <CommandBar.Content>
            <ctrl:LayoutSwitch
                x:Name="ItemsPanelSelector"
                Margin="6,8,0,0" />
          </CommandBar.Content>
          <AppBarElementContainer>
            <ast:AutoSuggestTokenBox
                x:Name="SearchBox"
                x:Uid="GadgetSearchBox"
                Width="600"
                Height="44"
                Margin="6,-2,6,6"
                HorizontalAlignment="Stretch"
                VerticalContentAlignment="Center"
                AvailableTokens="{x:Bind AvailableTokens, Mode=OneWay}"
                FilterCommand="{x:Bind ApplyFilterCommand}"
                ItemsSource="{x:Bind FilterTokens}"
                MaximumTokens="5"
                Style="{StaticResource DefaultAutoSuggestTokenBoxStyle}"
                SuggestedItemTemplate="{StaticResource SearchTokenTemplate}"
                SuggestedItemsSource="{x:Bind AvailableTokens.Values, Mode=OneWay}"
                Text="{x:Bind FilterText, Mode=TwoWay}"
                TokenItemTemplate="{StaticResource SearchTokenTemplate}">
              <ast:AutoSuggestTokenBox.QueryIcon>
                <FontIconSource Glyph="&#xE721;" />
              </ast:AutoSuggestTokenBox.QueryIcon>
            </ast:AutoSuggestTokenBox>
          </AppBarElementContainer>
        </CommandBar>
      </Border>
    </Border>

    <Border Grid.Row="1" Margin="16,0,16,16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
      <Border Style="{StaticResource AcrylicBorderCardStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Pivot
              x:Name="TabPivot"
              Grid.Row="0"
              Margin="8,0,0,0"
              ItemsSource="{x:Bind GadgetGroups, Mode=OneWay}"
              SelectionChanged="OnTabChanged">
            <Pivot.HeaderTemplate>
              <DataTemplate x:DataType="vm:GroupViewModel">
                <TextBlock Text="{x:Bind Header}" />
              </DataTemplate>
            </Pivot.HeaderTemplate>
            <Pivot.ItemTemplate>
              <DataTemplate x:DataType="vm:GroupViewModel">
                <Grid Visibility="Collapsed" />
              </DataTemplate>
            </Pivot.ItemTemplate>
          </Pivot>

          <ScrollViewer Grid.Row="1" Padding="8,4,8,8">
            <ItemsRepeater x:Name="CardRepeater"
                           ItemsSource="{x:Bind CurrentItems, Mode=OneWay}"
                           ElementPrepared="OnElementPrepared"
                           ElementClearing="OnElementClearing">
              <ItemsRepeater.Layout>
                <UniformGridLayout
                    MinItemWidth="260"
                    MinColumnSpacing="8"
                    MinRowSpacing="8"
                    ItemsStretch="Fill" />
              </ItemsRepeater.Layout>
            </ItemsRepeater>
          </ScrollViewer>
        </Grid>
      </Border>
    </Border>
  </Grid>
</UserControl>
