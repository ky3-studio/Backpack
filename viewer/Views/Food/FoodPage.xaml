<UserControl
    x:Class="Backpack.Viewer.Views.FoodPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:ast="using:Backpack.Viewer.Views.Controls.AutoSuggestBox"
    xmlns:ctrl="using:Backpack.Viewer.Views.Controls"
    xmlns:vm="using:Backpack.Viewer.ViewModels">

  <UserControl.Resources>
    <DataTemplate x:Key="FoodCardTemplate">
      <Grid
          Padding="10,8"
          Style="{ThemeResource GridShimmerStyle}"
          RowSpacing="8"
          DoubleTapped="OnCardDoubleTapped">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid Width="44" Height="44" VerticalAlignment="Center" CornerRadius="8">
            <Image Source="{Binding QualitySource}" Stretch="Fill" />
            <Image Source="ms-appx:///Assets/Quality/UI_ImgSign_ItemIcon.png" Stretch="Fill" />
            <Image Source="{Binding IconSource}" Stretch="Uniform" />
          </Grid>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock
                Style="{StaticResource AppBodyTextBlockStyle}"
                Text="{Binding Name}"
                TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock
                  Style="{StaticResource AppCaptionTextBlockStyle}"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Text="{Binding Character}"
                  Visibility="{Binding CharacterVisibility}" />
              <TextBlock
                  Style="{StaticResource AppCaptionTextBlockStyle}"
                  Foreground="{Binding VariantForeground}"
                  Text="{Binding VariantLabel}" />
            </StackPanel>
          </StackPanel>
          <TextBlock
              Grid.Column="2"
              MinWidth="36"
              Style="{StaticResource AppBodyStrongTextBlockStyle}"
              Text="{Binding Count}"
              TextAlignment="Right"
              VerticalAlignment="Center" />
        </Grid>
        <ItemsControl
            Grid.Row="1"
            ItemsSource="{Binding Ingredients}"
            HorizontalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border
                  Padding="5,3"
                  CornerRadius="5"
                  Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                  ToolTipService.ToolTip="{Binding Name}">
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <Image
                      Width="18"
                      Height="18"
                      VerticalAlignment="Center"
                      Source="{Binding IconSource}"
                      Stretch="Uniform" />
                  <TextBlock
                      Style="{StaticResource AppCaptionTextBlockStyle}"
                      Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                      Text="{Binding HeldText}"
                      Visibility="{Binding EnoughVisibility}"
                      VerticalAlignment="Center" />
                  <TextBlock
                      Style="{StaticResource AppCaptionTextBlockStyle}"
                      Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                      Text="{Binding HeldText}"
                      Visibility="{Binding ShortVisibility}"
                      VerticalAlignment="Center" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="FoodGridTemplate">
      <ctrl:VerticalCard Width="82">
        <ctrl:VerticalCard.Top>
          <ctrl:ItemIcon
              Icon="{Binding IconSource}"
              Quality="{Binding QualitySource}" />
        </ctrl:VerticalCard.Top>
        <ctrl:VerticalCard.Bottom>
          <StackPanel>
            <TextBlock
                Margin="2,0"
                MaxWidth="74"
                HorizontalAlignment="Center"
                Style="{StaticResource AppCaptionTextBlockStyle}"
                Text="{Binding Name}"
                TextAlignment="Center"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap"
                ToolTipService.ToolTip="{Binding Name}" />
            <TextBlock
                Margin="2,0"
                HorizontalAlignment="Center"
                Opacity="0.7"
                Style="{StaticResource AppCaptionTextBlockStyle}"
                Text="{Binding Count}" />
          </StackPanel>
        </ctrl:VerticalCard.Bottom>
      </ctrl:VerticalCard>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="auto" />
      <RowDefinition />
    </Grid.RowDefinitions>

    <Border Margin="16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
      <Border Style="{StaticResource AcrylicSecondaryBorderCardStyle}">
        <CommandBar
            BorderBrush="{x:Null}"
            BorderThickness="0"
            DefaultLabelPosition="Right">
          <CommandBar.Content>
            <ctrl:LayoutSwitch
                x:Name="ItemsPanelSelector"
                Margin="6,8,0,0" />
          </CommandBar.Content>
          <AppBarElementContainer>
            <ast:AutoSuggestTokenBox
                x:Name="SearchBox"
                x:Uid="FoodSearchBox"
                Width="600"
                Height="44"
                Margin="6,-2,6,6"
                HorizontalAlignment="Stretch"
                VerticalContentAlignment="Center"
                AvailableTokens="{x:Bind AvailableTokens, Mode=OneWay}"
                FilterCommand="{x:Bind ApplyFilterCommand}"
                ItemsSource="{x:Bind FilterTokens}"
                MaximumTokens="5"
                Style="{StaticResource DefaultAutoSuggestTokenBoxStyle}"
                SuggestedItemTemplate="{StaticResource SearchTokenTemplate}"
                SuggestedItemsSource="{x:Bind AvailableTokens.Values, Mode=OneWay}"
                Text="{x:Bind FilterText, Mode=TwoWay}"
                TokenItemTemplate="{StaticResource SearchTokenTemplate}">
              <ast:AutoSuggestTokenBox.QueryIcon>
                <FontIconSource Glyph="&#xE721;" />
              </ast:AutoSuggestTokenBox.QueryIcon>
            </ast:AutoSuggestTokenBox>
          </AppBarElementContainer>
        </CommandBar>
      </Border>
    </Border>

    <Border Grid.Row="1" Margin="16,0,16,16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
      <Border Style="{StaticResource AcrylicBorderCardStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Pivot
              x:Name="TabPivot"
              Grid.Row="0"
              Margin="8,0,0,0"
              ItemsSource="{x:Bind FoodGroups, Mode=OneWay}"
              SelectionChanged="OnTabChanged">
            <Pivot.HeaderTemplate>
              <DataTemplate x:DataType="vm:GroupViewModel">
                <TextBlock Text="{x:Bind Header}" />
              </DataTemplate>
            </Pivot.HeaderTemplate>
            <Pivot.ItemTemplate>
              <DataTemplate x:DataType="vm:GroupViewModel">
                <Grid Visibility="Collapsed" />
              </DataTemplate>
            </Pivot.ItemTemplate>
          </Pivot>

          <ScrollViewer Grid.Row="1" Padding="8,4,8,8">
            <ItemsRepeater x:Name="CardRepeater"
                           ItemsSource="{x:Bind CurrentItems, Mode=OneWay}"
                           ElementPrepared="OnElementPrepared"
                           ElementClearing="OnElementClearing">
              <ItemsRepeater.Layout>
                <UniformGridLayout
                    MinItemWidth="360"
                    MinColumnSpacing="8"
                    MinRowSpacing="8"
                    ItemsStretch="Fill" />
              </ItemsRepeater.Layout>
            </ItemsRepeater>
          </ScrollViewer>
        </Grid>
      </Border>
    </Border>
  </Grid>
</UserControl>
