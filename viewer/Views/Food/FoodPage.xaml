<UserControl
    x:Class="Backpack.Viewer.Views.FoodPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:vm="using:Backpack.Viewer.ViewModels">

  <Border Margin="16,8,16,16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
    <Border
        Background="{ThemeResource SystemControlAcrylicElementBrush}"
        BorderThickness="0"
        CornerRadius="{ThemeResource ControlCornerRadius}">
      <ScrollViewer Padding="16">
        <ItemsControl ItemsSource="{x:Bind FoodGroups, Mode=OneWay}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="16" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FoodGroupViewModel">
              <StackPanel Spacing="8">
                <TextBlock
                    Text="{x:Bind Header}"
                    Style="{StaticResource AppBodyStrongTextBlockStyle}" />
                <ItemsRepeater
                    ItemsSource="{x:Bind Items}"
                    ElementPrepared="OnRepeaterElementPrepared"
                    ElementClearing="OnRepeaterElementClearing">
                  <ItemsRepeater.Layout>
                    <UniformGridLayout
                        MinItemWidth="280"
                        MinColumnSpacing="8"
                        MinRowSpacing="8"
                        ItemsStretch="Fill" />
                  </ItemsRepeater.Layout>
                  <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:FoodViewModel">
                      <Grid
                          Padding="10,8"
                          Style="{ThemeResource GridShimmerStyle}"
                          ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid
                            Grid.Column="0"
                            Width="40"
                            Height="40"
                            VerticalAlignment="Center"
                            CornerRadius="6">
                          <Image Source="{x:Bind QualitySource}" Stretch="Fill" />
                          <Image Source="ms-appx:///Assets/Quality/UI_ImgSign_ItemIcon.png" Stretch="Fill" />
                          <Image
                              Width="36"
                              Height="36"
                              Source="{x:Bind IconSource, Mode=OneWay}"
                              Stretch="Uniform" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                          <TextBlock
                              Style="{StaticResource AppBodyTextBlockStyle}"
                              Text="{x:Bind Name}"
                              TextTrimming="CharacterEllipsis" />
                          <TextBlock
                              Style="{StaticResource AppCaptionTextBlockStyle}"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              Text="{x:Bind Character}"
                              Visibility="{x:Bind CharacterVisibility}"
                              TextTrimming="CharacterEllipsis" />
                          <TextBlock
                              Style="{StaticResource AppCaptionTextBlockStyle}"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                              Text="{x:Bind IngredientsText}"
                              TextWrapping="Wrap"
                              MaxLines="2" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="2"
                            MinWidth="40"
                            Style="{StaticResource AppBodyStrongTextBlockStyle}"
                            Text="{x:Bind Count}"
                            TextAlignment="Right"
                            VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
  </Border>
</UserControl>
