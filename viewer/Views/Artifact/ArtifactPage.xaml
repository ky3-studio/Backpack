<UserControl
    x:Class="Backpack.Viewer.Views.ArtifactPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:ctrl="using:Backpack.Viewer.Views.Controls"
    xmlns:ast="using:Backpack.Viewer.Views.Controls.AutoSuggestBox"
    xmlns:layout="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:Backpack.Viewer.ViewModels">

  <UserControl.Resources>

    <DataTemplate x:Key="ArtifactListTemplate" x:DataType="vm:ArtifactViewModel">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Width="44" Height="44" Margin="0,0,12,0" VerticalAlignment="Center" CornerRadius="6">
          <Image Source="{x:Bind QualitySource, Mode=OneWay}" Stretch="Fill" />
          <Image Source="ms-appx:///Assets/Quality/UI_ImgSign_ItemIcon.png" Stretch="Fill" />
          <Image Source="{x:Bind IconSource, Mode=OneWay}" Stretch="Uniform" />
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock
              Style="{StaticResource AppBodyStrongTextBlockStyle}"
              Text="{x:Bind Source.Set, Mode=OneWay}"
              TextTrimming="CharacterEllipsis"
              TextWrapping="NoWrap" />
          <TextBlock
              Opacity="0.7"
              Style="{StaticResource AppCaptionTextBlockStyle}"
              Text="{x:Bind Source.Name, Mode=OneWay}"
              TextTrimming="CharacterEllipsis"
              TextWrapping="NoWrap" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ArtifactGridTemplate" x:DataType="vm:ArtifactViewModel">
      <ctrl:VerticalCard Width="82">
        <ctrl:VerticalCard.Top>
          <ctrl:ItemIcon
              Icon="{x:Bind IconSource, Mode=OneWay}"
              Quality="{x:Bind QualitySource, Mode=OneWay}" />
        </ctrl:VerticalCard.Top>
        <ctrl:VerticalCard.Bottom>
          <TextBlock
              Margin="2,0"
              Text="{x:Bind Source.Name, Mode=OneWay}"
              TextTrimming="CharacterEllipsis" />
        </ctrl:VerticalCard.Bottom>
      </ctrl:VerticalCard>
    </DataTemplate>

    <DataTemplate x:Key="ArtifactDetailTemplate" x:DataType="vm:ArtifactViewModel">
      <StackPanel Spacing="12">

        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid Grid.Column="0" Width="80" Height="80" CornerRadius="8">
            <Image Source="{x:Bind QualitySource, Mode=OneWay}" Stretch="Fill" />
            <Image Source="ms-appx:///Assets/Quality/UI_ImgSign_ItemIcon.png" Stretch="Fill" />
            <Image Source="{x:Bind IconSource, Mode=OneWay}" Stretch="Uniform" />
          </Grid>
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock
                FontFamily="{StaticResource AppFontFamily}"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{x:Bind Source.Set, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource AppBodyTextBlockStyle}"
                Text="{x:Bind Source.Name, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource AppCaptionTextBlockStyle}"
                Text="{x:Bind SlotText, Mode=OneWay}" />
            <ItemsRepeater
                ItemsSource="{x:Bind RankItems, Mode=OneWay}"
                ItemTemplate="{StaticResource KiraStarItemTemplate}">
              <ItemsRepeater.Layout>
                <layout:StackLayout Orientation="Horizontal" Spacing="1" />
              </ItemsRepeater.Layout>
            </ItemsRepeater>
          </StackPanel>
          <TextBlock
              Grid.Column="2"
              MinWidth="40"
              FontFamily="{StaticResource AppFontFamily}"
              Style="{StaticResource SubtitleTextBlockStyle}"
              Text="{x:Bind Level, Mode=OneWay}"
              TextAlignment="Right"
              VerticalAlignment="Top"
              Visibility="{x:Bind HasInstanceVisibility, Mode=OneWay}" />
        </Grid>

        <StackPanel Spacing="0" Visibility="{x:Bind HasInstanceVisibility, Mode=OneWay}">
          <Border Height="1" Margin="0,2,0,8" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Style="{StaticResource AppBodyTextBlockStyle}"
                Text="{x:Bind Source.MainStat, Mode=OneWay}" />
            <TextBlock
                Grid.Column="1"
                Style="{StaticResource AppBodyStrongTextBlockStyle}"
                Text="{x:Bind MainStatValueDisplay, Mode=OneWay}" />
          </Grid>
          <StackPanel Margin="0,8,0,0" Spacing="6">
            <Grid Visibility="{x:Bind SubStat0Vis, Mode=OneWay}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource AppCaptionTextBlockStyle}" Text="{x:Bind SubStat0Name, Mode=OneWay}" />
              <TextBlock Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource AppCaptionTextBlockStyle}" Text="{x:Bind SubStat0Value, Mode=OneWay}" />
              <Image Grid.Column="2" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Center" Source="{x:Bind SubStat0Badge, Mode=OneWay}" />
            </Grid>
            <Grid Visibility="{x:Bind SubStat1Vis, Mode=OneWay}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource AppCaptionTextBlockStyle}" Text="{x:Bind SubStat1Name, Mode=OneWay}" />
              <TextBlock Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource AppCaptionTextBlockStyle}" Text="{x:Bind SubStat1Value, Mode=OneWay}" />
              <Image Grid.Column="2" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Center" Source="{x:Bind SubStat1Badge, Mode=OneWay}" />
            </Grid>
            <Grid Visibility="{x:Bind SubStat2Vis, Mode=OneWay}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource AppCaptionTextBlockStyle}" Text="{x:Bind SubStat2Name, Mode=OneWay}" />
              <TextBlock Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource AppCaptionTextBlockStyle}" Text="{x:Bind SubStat2Value, Mode=OneWay}" />
              <Image Grid.Column="2" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Center" Source="{x:Bind SubStat2Badge, Mode=OneWay}" />
            </Grid>
            <Grid Visibility="{x:Bind SubStat3Vis, Mode=OneWay}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource AppCaptionTextBlockStyle}" Text="{x:Bind SubStat3Name, Mode=OneWay}" />
              <TextBlock Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource AppCaptionTextBlockStyle}" Text="{x:Bind SubStat3Value, Mode=OneWay}" />
              <Image Grid.Column="2" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Center" Source="{x:Bind SubStat3Badge, Mode=OneWay}" />
            </Grid>
          </StackPanel>
        </StackPanel>

        <StackPanel Spacing="4" Visibility="{x:Bind HasAnyBonusVisibility, Mode=OneWay}">
          <Border Height="1" Margin="0,2,0,0" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
          <TextBlock
              Style="{StaticResource AppBodyStrongTextBlockStyle}"
              Text="{x:Bind Source.Set, Mode=OneWay}" />
          <TextBlock
              Style="{StaticResource AppCaptionTextBlockStyle}"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              Text="{x:Bind BonusText, Mode=OneWay}"
              TextWrapping="Wrap" />
        </StackPanel>

      </StackPanel>
    </DataTemplate>

  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="auto" />
      <RowDefinition />
    </Grid.RowDefinitions>

    <Border Margin="16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
      <Border Style="{StaticResource AcrylicSecondaryBorderCardStyle}">
        <CommandBar
            BorderBrush="{x:Null}"
            BorderThickness="0"
            DefaultLabelPosition="Right">
          <CommandBar.Content>
            <ctrl:LayoutSwitch
                x:Name="ItemsPanelSelector"
                Margin="6,8,0,0" />
          </CommandBar.Content>
          <AppBarElementContainer>
            <ast:AutoSuggestTokenBox
                x:Name="SearchBox"
                x:Uid="ArtifactSearchBox"
                Width="600"
                Height="44"
                Margin="6,-2,6,6"
                HorizontalAlignment="Stretch"
                VerticalContentAlignment="Center"
                AvailableTokens="{x:Bind ViewModel.AvailableTokens, Mode=OneWay}"
                FilterCommand="{x:Bind ViewModel.ApplyFilterCommand}"
                ItemsSource="{x:Bind ViewModel.FilterTokens}"
                MaximumTokens="5"
                Style="{StaticResource DefaultAutoSuggestTokenBoxStyle}"
                SuggestedItemTemplate="{StaticResource SearchTokenTemplate}"
                SuggestedItemsSource="{x:Bind ViewModel.AvailableTokens.Values, Mode=OneWay}"
                Text="{x:Bind ViewModel.FilterText, Mode=TwoWay}"
                TokenItemTemplate="{StaticResource SearchTokenTemplate}">
              <ast:AutoSuggestTokenBox.QueryIcon>
                <FontIconSource Glyph="&#xE721;" />
              </ast:AutoSuggestTokenBox.QueryIcon>
            </ast:AutoSuggestTokenBox>
          </AppBarElementContainer>
        </CommandBar>
      </Border>
    </Border>

    <cwc:SwitchPresenter
        Grid.Row="1"
        ContentTransitions="{ThemeResource EntranceThemeTransitions}"
        Value="{x:Bind ItemsPanelSelector.Current, Mode=OneWay}">

      <cwc:Case Value="List">
        <Border Margin="16,0,16,16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
          <Border Style="{StaticResource AcrylicBorderCardStyle}">
            <SplitView
                DisplayMode="Inline"
                IsPaneOpen="True"
                OpenPaneLength="{StaticResource CompatSplitViewOpenPaneLength}"
                PaneBackground="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
              <SplitView.Pane>
                <ListView
                    x:Name="ArtifactListView"
                    Padding="{StaticResource ListViewInSplitPanePadding}"
                    ItemTemplate="{StaticResource ArtifactListTemplate}"
                    ItemsSource="{x:Bind ViewModel.CurrentItems, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedArtifact, Mode=OneWay}"
                    SelectionMode="Single"
                    SelectionChanged="OnArtifactSelectionChanged" />
              </SplitView.Pane>
              <SplitView.Content>
                <Grid>
                  <StackPanel
                      VerticalAlignment="Center"
                      Visibility="{x:Bind ViewModel.EmptyStateVisible, Mode=OneWay}">
                    <Image
                        Height="120"
                        Source="{StaticResource UI_EmotionIcon89}" />
                    <TextBlock
                        x:Uid="ArtifactEmptyHint"
                        Margin="0,5,0,21"
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}" />
                  </StackPanel>
                  <ScrollViewer
                      x:Name="ContentScroller"
                      Padding="20"
                      Visibility="{x:Bind ViewModel.SelectedArtifactVisible, Mode=OneWay}">
                    <ContentPresenter
                        VerticalAlignment="Top"
                        Content="{x:Bind ViewModel.SelectedArtifact, Mode=OneWay}"
                        ContentTemplate="{StaticResource ArtifactDetailTemplate}" />
                  </ScrollViewer>
                </Grid>
              </SplitView.Content>
            </SplitView>
          </Border>
        </Border>
      </cwc:Case>

      <cwc:Case Value="Grid">
        <Border Margin="16,0,16,16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
          <Border Style="{StaticResource AcrylicBorderCardStyle}">
            <Grid Padding="16,16,4,-6">
              <StackPanel
                  VerticalAlignment="Center"
                  Visibility="{x:Bind ViewModel.EmptyStateVisible, Mode=OneWay}">
                <Image
                    Height="120"
                    Source="{StaticResource UI_EmotionIcon89}" />
                <TextBlock
                    x:Uid="ArtifactEmptyHint"
                    Margin="0,5,0,21"
                    HorizontalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}" />
              </StackPanel>
              <GridView
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  ItemContainerStyle="{StaticResource LargeGridViewItemStyle}"
                  ItemTemplate="{StaticResource ArtifactGridTemplate}"
                  ItemsSource="{x:Bind ViewModel.CurrentItems, Mode=OneWay}"
                  SelectionMode="Single"
                  SelectionChanged="OnArtifactSelectionChanged"
                  Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay}" />
            </Grid>
          </Border>
        </Border>
      </cwc:Case>

    </cwc:SwitchPresenter>

  </Grid>
</UserControl>
