<UserControl
    x:Class="Backpack.Viewer.Views.ArtifactPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:layout="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:Backpack.Viewer.ViewModels">

  <Border Margin="16,8,16,16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
    <Border
        Background="{ThemeResource SystemControlAcrylicElementBrush}"
        BorderThickness="0"
        CornerRadius="{ThemeResource ControlCornerRadius}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Pivot
            x:Name="TabPivot"
            Grid.Row="0"
            Margin="8,0,0,0"
            ItemsSource="{x:Bind ArtifactGroups, Mode=OneWay}"
            SelectionChanged="OnTabChanged">
          <Pivot.HeaderTemplate>
            <DataTemplate x:DataType="vm:GroupViewModel">
              <TextBlock Text="{x:Bind Header}" />
            </DataTemplate>
          </Pivot.HeaderTemplate>
          <Pivot.ItemTemplate>
            <DataTemplate x:DataType="vm:GroupViewModel">
              <Grid Visibility="Collapsed" />
            </DataTemplate>
          </Pivot.ItemTemplate>
        </Pivot>

        <ScrollViewer Grid.Row="1" Padding="16,4,16,16">
          <ItemsRepeater x:Name="TheRepeater"
                         ElementPrepared="OnElementPrepared"
                         ItemsSource="{x:Bind CurrentItems, Mode=OneWay}">
            <ItemsRepeater.Layout>
              <layout:UniformGridLayout
                  MinItemWidth="220"
                  MinColumnSpacing="8"
                  MinRowSpacing="8"
                  ItemsStretch="Fill" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="vm:ArtifactViewModel">
                <Grid Padding="10,10"
                      DoubleTapped="OnCardDoubleTapped"
                      Style="{ThemeResource GridShimmerStyle}">
                  <StackPanel Spacing="6">

                    <Grid ColumnSpacing="10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Grid Grid.Column="0" Width="40" Height="40" CornerRadius="6">
                        <Image Source="{x:Bind QualitySource, Mode=OneWay}" Stretch="Fill" />
                        <Image Source="ms-appx:///Assets/Quality/UI_ImgSign_ItemIcon.png" Stretch="Fill" />
                        <Image Source="{x:Bind IconSource, Mode=OneWay}" Stretch="Uniform" />
                      </Grid>
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock
                            Style="{StaticResource AppBodyStrongTextBlockStyle}"
                            Text="{x:Bind Source.Set, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource AppCaptionTextBlockStyle}"
                            Text="{x:Bind Source.Name, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource AppCaptionTextBlockStyle}"
                            Text="{x:Bind SlotText, Mode=OneWay}" />
                        <ItemsRepeater
                            ItemsSource="{x:Bind RankItems, Mode=OneWay}"
                            ItemTemplate="{StaticResource KiraStarItemTemplate}">
                          <ItemsRepeater.Layout>
                            <layout:StackLayout Orientation="Horizontal" Spacing="1" />
                          </ItemsRepeater.Layout>
                        </ItemsRepeater>
                      </StackPanel>
                      <TextBlock
                          Grid.Column="2"
                          MinWidth="32"
                          Style="{StaticResource AppBodyStrongTextBlockStyle}"
                          Text="{x:Bind Level, Mode=OneWay}"
                          TextAlignment="Right"
                          VerticalAlignment="Center"
                          Visibility="{x:Bind HasInstanceVisibility, Mode=OneWay}" />
                    </Grid>

                    <StackPanel Spacing="0" Visibility="{x:Bind HasInstanceVisibility, Mode=OneWay}">
                      <Border Height="1" Margin="0,2,0,6" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Style="{StaticResource AppCaptionTextBlockStyle}"
                            Text="{x:Bind Source.MainStat, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource AppCaptionTextBlockStyle}"
                            Text="{x:Bind MainStatValueDisplay, Mode=OneWay}" />
                      </Grid>
                      <StackPanel Margin="0,6,0,0" Spacing="0">
                        <StackPanel Margin="0,2" Spacing="1" Visibility="{x:Bind SubStat0Vis, Mode=OneWay}">
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource AppCaptionTextBlockStyle}" Text="{x:Bind SubStat0Name, Mode=OneWay}" />
                            <Image Grid.Column="1" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Center" Source="{x:Bind SubStat0Badge, Mode=OneWay}" />
                          </Grid>
                          <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource AppCaptionTextBlockStyle}" Text="{x:Bind SubStat0Value, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Margin="0,2" Spacing="1" Visibility="{x:Bind SubStat1Vis, Mode=OneWay}">
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource AppCaptionTextBlockStyle}" Text="{x:Bind SubStat1Name, Mode=OneWay}" />
                            <Image Grid.Column="1" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Center" Source="{x:Bind SubStat1Badge, Mode=OneWay}" />
                          </Grid>
                          <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource AppCaptionTextBlockStyle}" Text="{x:Bind SubStat1Value, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Margin="0,2" Spacing="1" Visibility="{x:Bind SubStat2Vis, Mode=OneWay}">
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource AppCaptionTextBlockStyle}" Text="{x:Bind SubStat2Name, Mode=OneWay}" />
                            <Image Grid.Column="1" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Center" Source="{x:Bind SubStat2Badge, Mode=OneWay}" />
                          </Grid>
                          <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource AppCaptionTextBlockStyle}" Text="{x:Bind SubStat2Value, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Margin="0,2" Spacing="1" Visibility="{x:Bind SubStat3Vis, Mode=OneWay}">
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource AppCaptionTextBlockStyle}" Text="{x:Bind SubStat3Name, Mode=OneWay}" />
                            <Image Grid.Column="1" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Center" Source="{x:Bind SubStat3Badge, Mode=OneWay}" />
                          </Grid>
                          <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource AppCaptionTextBlockStyle}" Text="{x:Bind SubStat3Value, Mode=OneWay}" />
                        </StackPanel>
                      </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="4" Visibility="{x:Bind HasAnyBonusVisibility, Mode=OneWay}">
                      <Border Height="1" Margin="0,2,0,0" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                      <TextBlock
                          MaxLines="2"
                          Style="{StaticResource AppCaptionTextBlockStyle}"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Text="{x:Bind BonusSummary, Mode=OneWay}"
                          TextTrimming="CharacterEllipsis">
                        <ToolTipService.ToolTip>
                          <ToolTip Content="{x:Bind BonusText, Mode=OneWay}" MaxWidth="400" />
                        </ToolTipService.ToolTip>
                      </TextBlock>
                    </StackPanel>

                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </ScrollViewer>
      </Grid>
    </Border>
  </Border>
</UserControl>
