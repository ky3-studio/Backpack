<UserControl
    x:Class="Backpack.Viewer.Views.ArtifactPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:vm="using:Backpack.Viewer.ViewModels">

  <Border Margin="16,8,16,16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
    <Border
        Background="{ThemeResource SystemControlAcrylicElementBrush}"
        BorderThickness="0"
        CornerRadius="{ThemeResource ControlCornerRadius}">
      <ScrollViewer Padding="16">
        <ItemsRepeater ItemsSource="{x:Bind Artifacts, Mode=OneWay}">
          <ItemsRepeater.Layout>
            <UniformGridLayout
                MinItemWidth="220"
                MinColumnSpacing="8"
                MinRowSpacing="8"
                ItemsStretch="Fill" />
          </ItemsRepeater.Layout>
          <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="vm:ArtifactViewModel">
              <Grid Padding="10,10" Style="{ThemeResource GridShimmerStyle}">
                <StackPanel Spacing="6">

                  <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        Grid.Column="0"
                        Width="40"
                        Height="40"
                        CornerRadius="6">
                      <Image Source="{x:Bind QualitySource}" Stretch="Fill" />
                      <Image Source="ms-appx:///Assets/Quality/UI_ImgSign_ItemIcon.png" Stretch="Fill" />
                      <Image
                          Width="36"
                          Height="36"
                          Source="{x:Bind IconSource}"
                          Stretch="Uniform"
                          ImageFailed="OnItemIconFailed" />
                    </Grid>
                    <StackPanel
                        Grid.Column="1"
                        Spacing="2"
                        VerticalAlignment="Center">
                      <TextBlock
                          Style="{StaticResource AppBodyStrongTextBlockStyle}"
                          Text="{x:Bind Source.SetName}"
                          TextTrimming="CharacterEllipsis" />
                      <TextBlock
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Style="{StaticResource AppCaptionTextBlockStyle}"
                          Text="{x:Bind Source.Name}"
                          TextTrimming="CharacterEllipsis" />
                      <TextBlock
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Style="{StaticResource AppCaptionTextBlockStyle}"
                          Text="{x:Bind SlotRankEquipped}" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="2"
                        MinWidth="32"
                        Style="{StaticResource AppBodyStrongTextBlockStyle}"
                        Text="{x:Bind Level}"
                        TextAlignment="Right"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind HasInstanceVisibility}" />
                  </Grid>

                  <StackPanel Spacing="0" Visibility="{x:Bind HasInstanceVisibility}">
                    <Border
                        Height="1"
                        Margin="0,2,0,6"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock
                          Grid.Column="0"
                          Style="{StaticResource AppCaptionTextBlockStyle}"
                          Text="{x:Bind Source.MainStat.Type}" />
                      <TextBlock
                          Grid.Column="1"
                          Style="{StaticResource AppCaptionTextBlockStyle}"
                          Text="{x:Bind MainStatValueDisplay}" />
                    </Grid>
                    <ItemsControl
                        Margin="0,6,0,0"
                        ItemsSource="{x:Bind SubStatItems}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SubStatItemViewModel">
                          <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="24" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource AppCaptionTextBlockStyle}"
                                Text="{x:Bind Name}" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="8,0"
                                Style="{StaticResource AppCaptionTextBlockStyle}"
                                Text="{x:Bind ValueDisplay}" />
                            <Border
                                Grid.Column="2"
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="10">
                              <TextBlock
                                  FontSize="11"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  Text="{x:Bind RollsText}" />
                            </Border>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
      </ScrollViewer>
    </Border>
  </Border>
</UserControl>
