<UserControl
    x:Class="Backpack.Viewer.Views.ArtifactPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:vm="using:Backpack.Viewer.ViewModels">

  <Border Margin="16,8,16,16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
    <Border
        Background="{ThemeResource SystemControlAcrylicElementBrush}"
        BorderThickness="0"
        CornerRadius="{ThemeResource ControlCornerRadius}">
      <ScrollViewer Padding="16">
        <ItemsRepeater x:Name="TheRepeater"
                       ItemsSource="{x:Bind Artifacts, Mode=OneWay}"
                       ElementPrepared="OnRepeaterElementPrepared"
                       ElementClearing="OnRepeaterElementClearing">
          <ItemsRepeater.Layout>
            <UniformGridLayout
                MinItemWidth="220"
                MinColumnSpacing="8"
                MinRowSpacing="8"
                ItemsStretch="Fill" />
          </ItemsRepeater.Layout>
          <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="vm:ArtifactViewModel">
              <Grid
                  Padding="10,10"
                  Style="{ThemeResource GridShimmerStyle}">
                <StackPanel Spacing="6">

                  <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        Grid.Column="0"
                        Width="40"
                        Height="40"
                        CornerRadius="6">
                      <Image Source="{x:Bind QualitySource}" Stretch="Fill" />
                      <Image Source="ms-appx:///Assets/Quality/UI_ImgSign_ItemIcon.png" Stretch="Fill" />
                      <Image
                          Source="{x:Bind IconSource, Mode=OneWay}"
                          Stretch="Uniform" />
                    </Grid>
                    <StackPanel
                        Grid.Column="1"
                        Spacing="2"
                        VerticalAlignment="Center">
                      <TextBlock
                          Style="{StaticResource AppBodyStrongTextBlockStyle}"
                          Text="{x:Bind Source.SetName}"
                          TextWrapping="WrapWholeWords" />
                      <TextBlock
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Style="{StaticResource AppCaptionTextBlockStyle}"
                          Text="{x:Bind Source.Name}"
                          TextWrapping="WrapWholeWords" />
                      <TextBlock
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Style="{StaticResource AppCaptionTextBlockStyle}"
                          Text="{x:Bind SlotRankEquipped}" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="2"
                        MinWidth="32"
                        Style="{StaticResource AppBodyStrongTextBlockStyle}"
                        Text="{x:Bind Level}"
                        TextAlignment="Right"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind HasInstanceVisibility}" />
                  </Grid>

                  <StackPanel Spacing="0" Visibility="{x:Bind HasInstanceVisibility}">
                    <Border
                        Height="1"
                        Margin="0,2,0,6"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock
                          Grid.Column="0"
                          Style="{StaticResource AppCaptionTextBlockStyle}"
                          Text="{x:Bind Source.MainStat.Type}" />
                      <TextBlock
                          Grid.Column="1"
                          Style="{StaticResource AppCaptionTextBlockStyle}"
                          Text="{x:Bind MainStatValueDisplay}" />
                    </Grid>
                    <ItemsControl
                        Margin="0,6,0,0"
                        ItemsSource="{x:Bind SubStatItems}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SubStatItemViewModel">
                          <StackPanel Margin="0,2" Spacing="1">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="22" />
                              </Grid.ColumnDefinitions>
                              <TextBlock
                                  Grid.Column="0"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  Style="{StaticResource AppCaptionTextBlockStyle}"
                                  Text="{x:Bind Name}" />
                              <Image
                                  Grid.Column="1"
                                  Width="20"
                                  Height="20"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Source="{x:Bind BadgeSource}" />
                            </Grid>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource AppCaptionTextBlockStyle}"
                                Text="{x:Bind ValueDisplay}"
                                TextWrapping="WrapWholeWords" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                  <StackPanel
                      Spacing="4"
                      Visibility="{x:Bind HasAnyBonusVisibility}">
                    <Border
                        Height="1"
                        Margin="0,2,0,0"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <TextBlock
                        MaxLines="5"
                        Style="{StaticResource AppCaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind BonusText}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="WrapWholeWords">
                      <ToolTipService.ToolTip>
                        <ToolTip Content="{x:Bind BonusText}" MaxWidth="400" />
                      </ToolTipService.ToolTip>
                    </TextBlock>
                  </StackPanel>

                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
      </ScrollViewer>
    </Border>
  </Border>
</UserControl>
