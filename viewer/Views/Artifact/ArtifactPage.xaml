<UserControl
    x:Class="Backpack.Viewer.Views.ArtifactPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:ctrl="using:Backpack.Viewer.Views.Controls"
    xmlns:ast="using:Backpack.Viewer.Views.Controls.AutoSuggestBox"
    xmlns:vm="using:Backpack.Viewer.ViewModels">

  <UserControl.Resources>

    <DataTemplate x:Key="ArtifactListTemplate" x:DataType="vm:ArtifactSetViewModel">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Image
            Grid.Column="0"
            Width="48"
            Height="48"
            Margin="0,0,12,0"
            VerticalAlignment="Center"
            Source="{x:Bind IconSource, Mode=OneWay}"
            Stretch="Uniform" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock
              Style="{StaticResource AppBodyStrongTextBlockStyle}"
              Text="{x:Bind SetName}"
              TextTrimming="CharacterEllipsis"
              TextWrapping="NoWrap" />
          <TextBlock
              FontFamily="{StaticResource AppFontFamily}"
              Foreground="{ThemeResource SystemFillColorSuccessBrush}"
              Style="{StaticResource AppCaptionTextBlockStyle}"
              Text="{x:Bind OwnedCountText}"
              Visibility="{x:Bind OwnedVisibility}" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ArtifactGridTemplate" x:DataType="vm:ArtifactSetViewModel">
      <ctrl:VerticalCard Width="82">
        <ctrl:VerticalCard.Top>
          <Image
              Width="56"
              Height="56"
              Source="{x:Bind IconSource, Mode=OneWay}"
              Stretch="Uniform" />
        </ctrl:VerticalCard.Top>
        <ctrl:VerticalCard.Bottom>
          <TextBlock
              Margin="2,0"
              Text="{x:Bind SetName}"
              TextAlignment="Center"
              TextTrimming="CharacterEllipsis" />
        </ctrl:VerticalCard.Bottom>
      </ctrl:VerticalCard>
    </DataTemplate>

    <DataTemplate x:Key="ArtifactPieceTabTemplate" x:DataType="vm:ArtifactPieceViewModel">
      <TextBlock Text="{x:Bind SlotName}" />
    </DataTemplate>

    <DataTemplate x:Key="ArtifactRankTabTemplate" x:DataType="vm:ArtifactRankOption">
      <Image Height="14" Source="{x:Bind Stars}" Stretch="Uniform" />
    </DataTemplate>

    <DataTemplate x:Key="ArtifactMainStatTemplate" x:DataType="vm:ArtifactStatRow">
      <Grid Margin="0,3,0,3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock
            Grid.Column="0"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource AppBodyTextBlockStyle}"
            Text="{x:Bind Name}" />
        <TextBlock
            Grid.Column="1"
            Style="{StaticResource AppBodyStrongTextBlockStyle}"
            Text="{x:Bind Value}" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="OwnedSubStatTemplate" x:DataType="vm:OwnedSubStat">
      <Grid Margin="0,3,0,3" ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              Style="{StaticResource AppCaptionTextBlockStyle}"
              Text="{x:Bind Name}" />
          <StackPanel
              Orientation="Horizontal"
              Spacing="5"
              Visibility="{x:Bind RollVisibility}">
            <Image
                Width="15"
                Height="15"
                VerticalAlignment="Center"
                Source="{x:Bind RollBadge}"
                Stretch="Uniform" />
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource AppCaptionTextBlockStyle}"
                Text="{x:Bind RollValues}" />
          </StackPanel>
        </StackPanel>
        <TextBlock
            Grid.Column="1"
            VerticalAlignment="Top"
            Style="{StaticResource AppCaptionTextBlockStyle}"
            Text="{x:Bind Value}" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="OwnedArtifactTemplate" x:DataType="vm:OwnedArtifactViewModel">
      <Border
          Width="290"
          Padding="12"
          Style="{StaticResource BorderCardStyle}">
        <StackPanel Spacing="8">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image
                Grid.Column="0"
                Width="44"
                Height="44"
                VerticalAlignment="Center"
                Source="{x:Bind IconSource, Mode=OneWay}"
                Stretch="Uniform" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock
                  Style="{StaticResource AppBodyStrongTextBlockStyle}"
                  Text="{x:Bind PieceName}"
                  TextTrimming="CharacterEllipsis" />
              <TextBlock
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Style="{StaticResource AppCaptionTextBlockStyle}"
                  Text="{x:Bind SlotName}" />
              <Image
                  Height="12"
                  HorizontalAlignment="Left"
                  Source="{x:Bind RankStarsSource}"
                  Stretch="Uniform" />
            </StackPanel>
            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                Style="{StaticResource AppBodyStrongTextBlockStyle}"
                Text="{x:Bind LevelText}" />
          </Grid>
          <Grid>
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource AppCaptionTextBlockStyle}"
                Text="{x:Bind MainStatName}" />
            <TextBlock
                HorizontalAlignment="Right"
                Style="{StaticResource AppBodyStrongTextBlockStyle}"
                Text="{x:Bind MainStatValue}" />
          </Grid>
          <ItemsControl
              ItemTemplate="{StaticResource OwnedSubStatTemplate}"
              ItemsSource="{x:Bind SubStats}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="ArtifactDetailTemplate" x:DataType="vm:ArtifactSetViewModel">
      <StackPanel Spacing="16">

        <Border Padding="16" Style="{StaticResource BorderCardStyle}">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image
                Grid.Column="0"
                Width="80"
                Height="80"
                VerticalAlignment="Top"
                Source="{x:Bind IconSource, Mode=OneWay}"
                Stretch="Uniform" />
            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
              <TextBlock
                  FontFamily="{StaticResource AppFontFamily}"
                  Style="{StaticResource SubtitleTextBlockStyle}"
                  Text="{x:Bind SetName}"
                  TextTrimming="CharacterEllipsis" />
              <Image
                  Height="16"
                  HorizontalAlignment="Left"
                  Source="{x:Bind RankStarsSource, Mode=OneWay}"
                  Stretch="Uniform" />
            </StackPanel>
          </Grid>
        </Border>

        <Border
            Padding="16"
            Style="{StaticResource BorderShimmerStyle}"
            Visibility="{x:Bind BonusVisibility}">
          <StackPanel Spacing="8">
            <TextBlock x:Uid="ArtifactBonusHeader" Style="{StaticResource AppBodyStrongTextBlockStyle}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource AppCaptionTextBlockStyle}"
                Text="{x:Bind BonusText}"
                TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Padding="16" Style="{StaticResource BorderShimmerStyle}">
          <StackPanel Spacing="12">
            <cwc:Segmented
                ItemTemplate="{StaticResource ArtifactPieceTabTemplate}"
                ItemsSource="{x:Bind Pieces}"
                SelectedIndex="{x:Bind SelectedPieceIndex, Mode=TwoWay}" />

            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Image
                  Grid.Column="0"
                  Width="48"
                  Height="48"
                  VerticalAlignment="Center"
                  Source="{x:Bind SelectedPiece.IconSource, Mode=OneWay}"
                  Stretch="Uniform" />
              <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Style="{StaticResource AppBodyStrongTextBlockStyle}"
                  Text="{x:Bind SelectedPiece.PieceName, Mode=OneWay}"
                  TextWrapping="Wrap" />
            </Grid>

            <cwc:Segmented
                ItemTemplate="{StaticResource ArtifactRankTabTemplate}"
                ItemsSource="{x:Bind RankOptions}"
                SelectedIndex="{x:Bind SelectedRankIndex, Mode=TwoWay}"
                Visibility="{x:Bind RankSwitchVisibility}" />

            <Grid>
              <TextBlock
                  x:Uid="ArtifactMainStatHeader"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Style="{StaticResource AppCaptionTextBlockStyle}" />
              <TextBlock
                  HorizontalAlignment="Right"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Style="{StaticResource AppCaptionTextBlockStyle}"
                  Text="{x:Bind LevelText, Mode=OneWay}" />
            </Grid>
            <Slider
                Maximum="{x:Bind MaxLevel, Mode=OneWay}"
                Minimum="0"
                StepFrequency="1"
                Value="{x:Bind Level, Mode=TwoWay}" />

            <ItemsControl
                ItemTemplate="{StaticResource ArtifactMainStatTemplate}"
                ItemsSource="{x:Bind MainStatRows, Mode=OneWay}" />
          </StackPanel>
        </Border>

        <Border
            Padding="16"
            Style="{StaticResource BorderShimmerStyle}"
            Visibility="{x:Bind SelectedPiece.StoryVisibility, Mode=OneWay}">
          <StackPanel Spacing="8">
            <TextBlock x:Uid="ArtifactFlavorHeader" Style="{StaticResource AppBodyStrongTextBlockStyle}" />
            <TextBlock
                IsTextSelectionEnabled="True"
                Opacity="0.8"
                Text="{x:Bind SelectedPiece.Story, Mode=OneWay}"
                TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border
            Padding="16"
            Style="{StaticResource BorderShimmerStyle}"
            Visibility="{x:Bind OwnedVisibility, Mode=OneWay}">
          <StackPanel Spacing="12">
            <TextBlock x:Uid="ArtifactOwnedHeader" Style="{StaticResource AppBodyStrongTextBlockStyle}" />
            <cwc:Segmented
                ItemTemplate="{StaticResource ArtifactRankTabTemplate}"
                ItemsSource="{x:Bind OwnedRankOptions}"
                SelectedIndex="{x:Bind SelectedOwnedRankIndex, Mode=TwoWay}"
                Visibility="{x:Bind OwnedRankSwitchVisibility}" />
            <ItemsControl
                ItemTemplate="{StaticResource OwnedArtifactTemplate}"
                ItemsSource="{x:Bind VisibleOwnedPieces, Mode=OneWay}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <cwc:WrapPanel HorizontalSpacing="8" VerticalSpacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>
        </Border>

      </StackPanel>
    </DataTemplate>

  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="auto" />
      <RowDefinition />
    </Grid.RowDefinitions>

    <Border Margin="16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
      <Border Style="{StaticResource AcrylicSecondaryBorderCardStyle}">
        <CommandBar
            BorderBrush="{x:Null}"
            BorderThickness="0"
            DefaultLabelPosition="Right">
          <CommandBar.Content>
            <ctrl:LayoutSwitch
                x:Name="ItemsPanelSelector"
                Margin="6,8,0,0" />
          </CommandBar.Content>
          <AppBarElementContainer>
            <ast:AutoSuggestTokenBox
                x:Name="SearchBox"
                x:Uid="ArtifactSearchBox"
                Width="600"
                Height="44"
                Margin="6,-2,6,6"
                HorizontalAlignment="Stretch"
                VerticalContentAlignment="Center"
                AvailableTokens="{x:Bind ViewModel.AvailableTokens, Mode=OneWay}"
                FilterCommand="{x:Bind ViewModel.ApplyFilterCommand}"
                ItemsSource="{x:Bind ViewModel.FilterTokens}"
                MaximumTokens="5"
                Style="{StaticResource DefaultAutoSuggestTokenBoxStyle}"
                SuggestedItemTemplate="{StaticResource SearchTokenTemplate}"
                SuggestedItemsSource="{x:Bind ViewModel.AvailableTokens.Values, Mode=OneWay}"
                Text="{x:Bind ViewModel.FilterText, Mode=TwoWay}"
                TokenItemTemplate="{StaticResource SearchTokenTemplate}">
              <ast:AutoSuggestTokenBox.QueryIcon>
                <FontIconSource Glyph="&#xE721;" />
              </ast:AutoSuggestTokenBox.QueryIcon>
            </ast:AutoSuggestTokenBox>
          </AppBarElementContainer>
        </CommandBar>
      </Border>
    </Border>

    <cwc:SwitchPresenter
        Grid.Row="1"
        ContentTransitions="{ThemeResource EntranceThemeTransitions}"
        Value="{x:Bind ItemsPanelSelector.Current, Mode=OneWay}">

      <cwc:Case Value="List">
        <Border Margin="16,0,16,16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
          <Border Style="{StaticResource AcrylicBorderCardStyle}">
            <SplitView
                DisplayMode="Inline"
                IsPaneOpen="True"
                OpenPaneLength="{StaticResource CompatSplitViewOpenPaneLength}"
                PaneBackground="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
              <SplitView.Pane>
                <ListView
                    x:Name="ArtifactListView"
                    Padding="{StaticResource ListViewInSplitPanePadding}"
                    ItemTemplate="{StaticResource ArtifactListTemplate}"
                    ItemsSource="{x:Bind ViewModel.CurrentItems, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedArtifact, Mode=OneWay}"
                    SelectionMode="Single"
                    SelectionChanged="OnArtifactSelectionChanged" />
              </SplitView.Pane>
              <SplitView.Content>
                <Grid>
                  <StackPanel
                      VerticalAlignment="Center"
                      Visibility="{x:Bind ViewModel.EmptyStateVisible, Mode=OneWay}">
                    <Image
                        Height="120"
                        Source="{StaticResource UI_EmotionIcon89}" />
                    <TextBlock
                        x:Uid="ArtifactEmptyHint"
                        Margin="0,5,0,21"
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}" />
                  </StackPanel>
                  <ScrollViewer
                      x:Name="ContentScroller"
                      Padding="16"
                      Visibility="{x:Bind ViewModel.SelectedArtifactVisible, Mode=OneWay}">
                    <ContentPresenter
                        VerticalAlignment="Top"
                        Content="{x:Bind ViewModel.SelectedArtifact, Mode=OneWay}"
                        ContentTemplate="{StaticResource ArtifactDetailTemplate}" />
                  </ScrollViewer>
                </Grid>
              </SplitView.Content>
            </SplitView>
          </Border>
        </Border>
      </cwc:Case>

      <cwc:Case Value="Grid">
        <Border Margin="16,0,16,16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
          <Border Style="{StaticResource AcrylicBorderCardStyle}">
            <Grid Padding="16,16,4,-6">
              <StackPanel
                  VerticalAlignment="Center"
                  Visibility="{x:Bind ViewModel.EmptyStateVisible, Mode=OneWay}">
                <Image
                    Height="120"
                    Source="{StaticResource UI_EmotionIcon89}" />
                <TextBlock
                    x:Uid="ArtifactEmptyHint"
                    Margin="0,5,0,21"
                    HorizontalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}" />
              </StackPanel>
              <GridView
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  ItemContainerStyle="{StaticResource LargeGridViewItemStyle}"
                  ItemTemplate="{StaticResource ArtifactGridTemplate}"
                  ItemsSource="{x:Bind ViewModel.CurrentItems, Mode=OneWay}"
                  SelectionMode="Single"
                  SelectionChanged="OnArtifactSelectionChanged"
                  Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay}" />
            </Grid>
          </Border>
        </Border>
      </cwc:Case>

    </cwc:SwitchPresenter>

  </Grid>
</UserControl>
