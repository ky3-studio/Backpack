<UserControl
    x:Class="Backpack.Viewer.Views.WeaponPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:vm="using:Backpack.Viewer.ViewModels">

  <UserControl.Resources>
    <DataTemplate x:Key="WeaponCardTemplate">
      <Grid Padding="10" Style="{ThemeResource GridShimmerStyle}">
        <StackPanel Spacing="6">

          <Grid Width="64" Height="64" HorizontalAlignment="Center" CornerRadius="8">
            <Image Source="{Binding QualitySource}" Stretch="Fill" />
            <Image Source="ms-appx:///Assets/Quality/UI_ImgSign_ItemIcon.png" Stretch="Fill" />
            <Image Source="{Binding IconSource}" Stretch="Uniform" />
          </Grid>

          <TextBlock
              FontSize="14"
              HorizontalTextAlignment="Center"
              Style="{StaticResource AppBodyStrongTextBlockStyle}"
              Text="{Binding Source.Name}"
              TextWrapping="Wrap" />

          <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource AppCaptionTextBlockStyle}"
                Text="{Binding Source.Type}" />
            <ItemsRepeater
                VerticalAlignment="Center"
                ItemsSource="{Binding RankItems}"
                ItemTemplate="{StaticResource KiraStarItemTemplate}">
              <ItemsRepeater.Layout>
                <StackLayout Orientation="Horizontal" Spacing="2" />
              </ItemsRepeater.Layout>
            </ItemsRepeater>
          </StackPanel>

          <StackPanel Spacing="3" Visibility="{Binding HasInstanceVisibility}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock
                  x:Uid="WeaponBaseAtkLabel"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Style="{StaticResource AppCaptionTextBlockStyle}" />
              <TextBlock
                  Grid.Column="1"
                  Style="{StaticResource AppBodyStrongTextBlockStyle}"
                  Text="{Binding AtkDisplay}" />
            </Grid>
            <Grid Visibility="{Binding SubVisibility}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Style="{StaticResource AppCaptionTextBlockStyle}"
                  Text="{Binding Source.MainStat}" />
              <TextBlock
                  Grid.Column="1"
                  Style="{StaticResource AppBodyStrongTextBlockStyle}"
                  Text="{Binding SubDisplay}" />
            </Grid>
          </StackPanel>

          <StackPanel
              HorizontalAlignment="Center"
              Orientation="Horizontal"
              Spacing="10"
              Visibility="{Binding HasInstanceVisibility}">
            <TextBlock
                Style="{StaticResource AppCaptionTextBlockStyle}"
                Text="{Binding LevelFull}" />
            <TextBlock
                Foreground="{ThemeResource WeaponGoldBrush}"
                Style="{StaticResource AppCaptionTextBlockStyle}"
                Text="{Binding RefineLabel}" />
          </StackPanel>

          <StackPanel Spacing="2" Visibility="{Binding HasInstanceVisibility}">
            <TextBlock
                Foreground="{ThemeResource WeaponGoldBrush}"
                Style="{StaticResource AppCaptionTextBlockStyle}"
                Text="{Binding PassiveName}"
                Visibility="{Binding PassiveVisibility}" />
            <TextBlock
                Style="{StaticResource AppCaptionTextBlockStyle}"
                Text="{Binding SkillDesc}"
                TextWrapping="Wrap" />
          </StackPanel>

        </StackPanel>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Border Margin="16,8,16,16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
    <Border
        Background="{ThemeResource SystemControlAcrylicElementBrush}"
        BorderThickness="0"
        CornerRadius="{ThemeResource ControlCornerRadius}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Button x:Name="FocusSink" Width="0" Height="0" IsTabStop="False" UseSystemFocusVisuals="False" Padding="0" BorderThickness="0" Background="Transparent" />

        <Pivot
            x:Name="TabPivot"
            Grid.Row="0"
            Margin="8,0,0,0"
            ItemsSource="{x:Bind WeaponGroups, Mode=OneWay}"
            SelectionChanged="OnTabChanged">
          <Pivot.HeaderTemplate>
            <DataTemplate x:DataType="vm:GroupViewModel">
              <TextBlock Text="{x:Bind Header}" />
            </DataTemplate>
          </Pivot.HeaderTemplate>
          <Pivot.ItemTemplate>
            <DataTemplate x:DataType="vm:GroupViewModel">
              <Grid Visibility="Collapsed" />
            </DataTemplate>
          </Pivot.ItemTemplate>
          <Pivot.RightHeader>
            <StackPanel
                Margin="0,0,16,0"
                Orientation="Horizontal"
                Spacing="6"
                VerticalAlignment="Center">
              <Button VerticalAlignment="Center">
                <Grid>
                  <FontIcon FontSize="16" Glyph="&#xE71C;" />
                  <Border
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Margin="0,-6,-6,0"
                      Background="{ThemeResource AccentFillColorDefaultBrush}"
                      CornerRadius="6"
                      MinWidth="14"
                      Padding="3,0"
                      Visibility="{x:Bind ActiveFilterBadgeVisibility, Mode=OneWay}">
                    <TextBlock
                        FontSize="9"
                        Foreground="White"
                        HorizontalTextAlignment="Center"
                        Text="{x:Bind ActiveFilterCount, Mode=OneWay}" />
                  </Border>
                </Grid>
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedRight">
                    <StackPanel Width="260" Spacing="2">
                      <Grid Margin="4,0,4,8">
                        <TextBlock
                            x:Uid="WeaponFilterTitle"
                            Style="{StaticResource AppBodyStrongTextBlockStyle}"
                            VerticalAlignment="Center" />
                        <HyperlinkButton
                            x:Uid="WeaponFilterClear"
                            HorizontalAlignment="Right"
                            Padding="4,0"
                            Click="OnClearFilter"
                            Visibility="{x:Bind ActiveFilterBadgeVisibility, Mode=OneWay}" />
                      </Grid>
                      <ItemsRepeater ItemsSource="{x:Bind RankFilters, Mode=OneTime}">
                        <ItemsRepeater.Layout>
                          <StackLayout Orientation="Vertical" Spacing="2" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                          <DataTemplate x:DataType="vm:FilterOption">
                            <ToggleButton
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                Click="OnFilterToggled"
                                Padding="8,6"
                                Tag="{x:Bind Mode=OneTime}">
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <ItemsRepeater ItemsSource="{x:Bind StarItems, Mode=OneTime}">
                                  <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="1" />
                                  </ItemsRepeater.Layout>
                                  <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                      <BitmapIcon
                                          Width="12"
                                          Height="12"
                                          Foreground="{ThemeResource WeaponGoldBrush}"
                                          UriSource="ms-appx:///Assets/UI_IconKira.png" />
                                    </DataTemplate>
                                  </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                                <TextBlock
                                    Text="{x:Bind Label, Mode=OneTime}"
                                    VerticalAlignment="Center" />
                              </StackPanel>
                            </ToggleButton>
                          </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                      </ItemsRepeater>
                      <Border
                          Height="1"
                          Margin="4,6"
                          Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                      <ItemsRepeater ItemsSource="{x:Bind TypeFilters, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                          <StackLayout Orientation="Vertical" Spacing="2" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                          <DataTemplate x:DataType="vm:FilterOption">
                            <ToggleButton
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                Click="OnFilterToggled"
                                Padding="8,6"
                                Tag="{x:Bind Mode=OneTime}">
                              <TextBlock Text="{x:Bind Label, Mode=OneTime}" />
                            </ToggleButton>
                          </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                      </ItemsRepeater>
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <AutoSuggestBox
                  x:Name="SearchBox"
                  x:Uid="WeaponSearchBox"
                  Width="320"
                  VerticalAlignment="Center"
                  QueryIcon="Find"
                  TextMemberPath="TextValue"
                  QuerySubmitted="OnQuerySubmitted"
                  SuggestionChosen="OnSuggestionChosen"
                  TextChanged="OnSearchTextChanged">
                <AutoSuggestBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:SearchSuggestion">
                    <TextBlock Text="{x:Bind DisplayLabel, Mode=OneTime}" />
                  </DataTemplate>
                </AutoSuggestBox.ItemTemplate>
              </AutoSuggestBox>
            </StackPanel>
          </Pivot.RightHeader>
        </Pivot>

        <ScrollViewer x:Name="ContentScroller" Grid.Row="1" Padding="8,4,8,8">
          <ItemsRepeater x:Name="CardRepeater"
                         ItemsSource="{x:Bind CurrentItems, Mode=OneWay}"
                         ElementPrepared="OnElementPrepared"
                         ElementClearing="OnElementClearing">
          <ItemsRepeater.Layout>
            <UniformGridLayout
                MinItemWidth="200"
                MinColumnSpacing="8"
                MinRowSpacing="8"
                ItemsStretch="Fill" />
          </ItemsRepeater.Layout>
          </ItemsRepeater>
        </ScrollViewer>
      </Grid>
    </Border>
  </Border>
</UserControl>
