<UserControl
    x:Class="Backpack.Viewer.Views.WeaponPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:vm="using:Backpack.Viewer.ViewModels">

  <Border Margin="16,8,16,16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
    <Border
        Background="{ThemeResource SystemControlAcrylicElementBrush}"
        BorderThickness="0"
        CornerRadius="{ThemeResource ControlCornerRadius}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Pivot
            x:Name="TabPivot"
            Grid.Row="0"
            Margin="8,0,0,0"
            ItemsSource="{x:Bind WeaponGroups, Mode=OneWay}"
            SelectionChanged="OnTabChanged">
          <Pivot.HeaderTemplate>
            <DataTemplate x:DataType="vm:GroupViewModel">
              <TextBlock Text="{x:Bind Header}" />
            </DataTemplate>
          </Pivot.HeaderTemplate>
          <Pivot.ItemTemplate>
            <DataTemplate x:DataType="vm:GroupViewModel">
              <Grid Visibility="Collapsed" />
            </DataTemplate>
          </Pivot.ItemTemplate>
        </Pivot>

        <ScrollViewer Grid.Row="1" Padding="8,4,8,8">
          <ItemsRepeater ItemsSource="{x:Bind CurrentItems, Mode=OneWay}">
          <ItemsRepeater.Layout>
            <UniformGridLayout
                MinItemWidth="200"
                MinColumnSpacing="8"
                MinRowSpacing="8"
                ItemsStretch="Fill" />
          </ItemsRepeater.Layout>
          <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="vm:WeaponViewModel">
              <Grid Padding="10" Style="{ThemeResource GridShimmerStyle}">
                <StackPanel Spacing="6">

                  <Grid
                      Width="64"
                      Height="64"
                      HorizontalAlignment="Center"
                      CornerRadius="8">
                    <Image Source="{x:Bind QualitySource}" Stretch="Fill" />
                    <Image Source="ms-appx:///Assets/Quality/UI_ImgSign_ItemIcon.png" Stretch="Fill" />
                    <Image
                        Source="{x:Bind IconSource, Mode=OneWay}"
                        Stretch="Uniform" />
                  </Grid>

                  <TextBlock
                      FontSize="14"
                      HorizontalTextAlignment="Center"
                      Style="{StaticResource AppBodyStrongTextBlockStyle}"
                      Text="{x:Bind Source.Name}"
                      TextWrapping="Wrap" />

                  <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource AppCaptionTextBlockStyle}"
                        Text="{x:Bind Source.Type}" />
                    <ItemsRepeater
                        VerticalAlignment="Center"
                        ItemsSource="{x:Bind RankItems}"
                        ItemTemplate="{StaticResource KiraStarItemTemplate}">
                      <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="2" />
                      </ItemsRepeater.Layout>
                    </ItemsRepeater>
                  </StackPanel>

                  <StackPanel Spacing="3" Visibility="{x:Bind HasInstanceVisibility}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock
                          x:Uid="WeaponBaseAtkLabel"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Style="{StaticResource AppCaptionTextBlockStyle}" />
                      <TextBlock
                          Grid.Column="1"
                          Style="{StaticResource AppBodyStrongTextBlockStyle}"
                          Text="{x:Bind AtkDisplay}" />
                    </Grid>
                    <Grid Visibility="{x:Bind SubVisibility}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Style="{StaticResource AppCaptionTextBlockStyle}"
                          Text="{x:Bind Source.MainStat}" />
                      <TextBlock
                          Grid.Column="1"
                          Style="{StaticResource AppBodyStrongTextBlockStyle}"
                          Text="{x:Bind SubDisplay}" />
                    </Grid>
                  </StackPanel>

                  <StackPanel
                      HorizontalAlignment="Center"
                      Orientation="Horizontal"
                      Spacing="10"
                      Visibility="{x:Bind HasInstanceVisibility}">
                    <TextBlock
                        Style="{StaticResource AppCaptionTextBlockStyle}"
                        Text="{x:Bind LevelFull}" />
                    <TextBlock
                        Foreground="{ThemeResource WeaponGoldBrush}"
                        Style="{StaticResource AppCaptionTextBlockStyle}"
                        Text="{x:Bind RefineLabel}" />
                  </StackPanel>

                  <StackPanel
                      Spacing="2"
                      Visibility="{x:Bind HasInstanceVisibility}">
                    <TextBlock
                        Foreground="{ThemeResource WeaponGoldBrush}"
                        Style="{StaticResource AppCaptionTextBlockStyle}"
                        Text="{x:Bind PassiveName}"
                        Visibility="{x:Bind PassiveVisibility}" />
                    <TextBlock
                        Style="{StaticResource AppCaptionTextBlockStyle}"
                        Text="{x:Bind SkillDesc}"
                        TextWrapping="Wrap" />
                  </StackPanel>

                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </ScrollViewer>
      </Grid>
    </Border>
  </Border>
</UserControl>
