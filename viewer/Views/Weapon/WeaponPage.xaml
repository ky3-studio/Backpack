<UserControl
    x:Class="Backpack.Viewer.Views.WeaponPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:ctrl="using:Backpack.Viewer.Views.Controls"
    xmlns:ast="using:Backpack.Viewer.Views.Controls.AutoSuggestBox"
    xmlns:mihoyo="using:Backpack.Viewer.Controls"
    xmlns:vm="using:Backpack.Viewer.ViewModels">

  <UserControl.Resources>

    <DataTemplate x:Key="WeaponListTemplate" x:DataType="vm:WeaponViewModel">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="auto" />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Image
            Width="48"
            Height="48"
            Margin="0,0,12,6"
            Source="{x:Bind IconSource, Mode=OneWay}"
            Stretch="Uniform" />
        <TextBlock
            Grid.Column="1"
            Margin="12,0,0,0"
            VerticalAlignment="Center"
            Text="{x:Bind Source.Name}" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="CultivationItemTemplate" x:DataType="vm:MaterialItemViewModel">
      <ctrl:HorizontalCard>
        <ctrl:HorizontalCard.Left>
          <ctrl:ItemIcon
              Width="40"
              Height="40"
              Icon="{x:Bind IconSource, Mode=OneWay}"
              Quality="{x:Bind Quality}" />
        </ctrl:HorizontalCard.Left>
        <ctrl:HorizontalCard.Right>
          <TextBlock
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Text="{x:Bind Name}" />
        </ctrl:HorizontalCard.Right>
      </ctrl:HorizontalCard>
    </DataTemplate>

    <DataTemplate x:Key="WeaponGridTemplate" x:DataType="vm:WeaponViewModel">
      <ctrl:VerticalCard Width="82">
        <ctrl:VerticalCard.Top>
          <ctrl:ItemIcon
              Icon="{x:Bind IconSource, Mode=OneWay}"
              Quality="{x:Bind QualitySource}" />
        </ctrl:VerticalCard.Top>
        <ctrl:VerticalCard.Bottom>
          <TextBlock
              Margin="2,0"
              Text="{x:Bind Source.Name}"
              TextTrimming="CharacterEllipsis" />
        </ctrl:VerticalCard.Bottom>
      </ctrl:VerticalCard>
    </DataTemplate>

    <DataTemplate x:Key="WeaponAvatarTemplate" x:DataType="vm:WeaponRecommendAvatar">
      <ctrl:ItemIcon
          Width="64"
          Height="64"
          Icon="{x:Bind Icon}"
          Quality="{x:Bind Quality}"
          ToolTipService.ToolTip="{x:Bind Name}" />
    </DataTemplate>

  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="auto" />
      <RowDefinition />
    </Grid.RowDefinitions>

    <Border Margin="16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
      <Border Style="{StaticResource AcrylicSecondaryBorderCardStyle}">
        <CommandBar
            BorderBrush="{x:Null}"
            BorderThickness="0"
            DefaultLabelPosition="Right">
          <CommandBar.Content>
            <ctrl:LayoutSwitch
                x:Name="ItemsPanelSelector"
                Margin="6,8,0,0" />
          </CommandBar.Content>
          <AppBarElementContainer>
            <ast:AutoSuggestTokenBox
                x:Name="SearchBox"
                x:Uid="WeaponSearchBox"
                Width="600"
                Height="44"
                Margin="6,-2,6,6"
                HorizontalAlignment="Stretch"
                VerticalContentAlignment="Center"
                AvailableTokens="{x:Bind ViewModel.AvailableTokens, Mode=OneWay}"
                FilterCommand="{x:Bind ViewModel.ApplyFilterCommand}"
                ItemsSource="{x:Bind ViewModel.FilterTokens}"
                MaximumTokens="5"
                Style="{StaticResource DefaultAutoSuggestTokenBoxStyle}"
                SuggestedItemTemplate="{StaticResource SearchTokenTemplate}"
                SuggestedItemsSource="{x:Bind ViewModel.AvailableTokens.Values, Mode=OneWay}"
                Text="{x:Bind ViewModel.FilterText, Mode=TwoWay}"
                TokenItemTemplate="{StaticResource SearchTokenTemplate}">
              <ast:AutoSuggestTokenBox.QueryIcon>
                <FontIconSource Glyph="&#xE721;" />
              </ast:AutoSuggestTokenBox.QueryIcon>
            </ast:AutoSuggestTokenBox>
          </AppBarElementContainer>
        </CommandBar>
      </Border>
    </Border>

    <cwc:SwitchPresenter
        Grid.Row="1"
        ContentTransitions="{ThemeResource EntranceThemeTransitions}"
        Value="{x:Bind ItemsPanelSelector.Current, Mode=OneWay}">

      <cwc:Case Value="List">
        <Border Margin="16,0,16,16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
          <Border Style="{StaticResource AcrylicBorderCardStyle}">
            <SplitView
                DisplayMode="Inline"
                IsPaneOpen="True"
                OpenPaneLength="{StaticResource CompatSplitViewOpenPaneLength}"
                PaneBackground="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
              <SplitView.Pane>
                <ListView
                    x:Name="WeaponListView"
                    Padding="{StaticResource ListViewInSplitPanePadding}"
                    ItemTemplate="{StaticResource WeaponListTemplate}"
                    ItemsSource="{x:Bind ViewModel.CurrentItems, Mode=OneWay}"
                    SelectionMode="Single"
                    SelectionChanged="OnWeaponSelectionChanged" />
              </SplitView.Pane>
              <SplitView.Content>
                <Grid>
                  <StackPanel
                      VerticalAlignment="Center"
                      Visibility="{x:Bind ViewModel.EmptyStateVisible, Mode=OneWay}">
                    <Image
                        Height="120"
                        Source="{StaticResource UI_EmotionIcon89}" />
                    <TextBlock
                        x:Uid="WeaponEmptyHint"
                        Margin="0,5,0,21"
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}" />
                  </StackPanel>
                  <ScrollViewer
                      x:Name="ContentScroller"
                      IsTabStop="True"
                      UseSystemFocusVisuals="False"
                      Visibility="{x:Bind ViewModel.SelectedWeaponVisible, Mode=OneWay}">
                    <StackPanel Padding="16" Spacing="16">

                      <Border Padding="16" Style="{StaticResource BorderCardStyle}">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition />
                          </Grid.ColumnDefinitions>
                          <ctrl:ItemIcon
                              Width="96"
                              Height="96"
                              Icon="{x:Bind ViewModel.SelectedWeapon.IconSource, Mode=OneWay}"
                              Quality="{x:Bind ViewModel.SelectedWeapon.QualitySource, Mode=OneWay}" />
                          <StackPanel
                              Grid.Column="1"
                              Margin="16,0,0,0"
                              VerticalAlignment="Center">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="10">
                              <Image
                                  Width="32"
                                  Height="32"
                                  VerticalAlignment="Center"
                                  Source="{x:Bind ViewModel.SelectedWeapon.TypeIconSource, Mode=OneWay}" />
                              <Image
                                  Width="30"
                                  Height="30"
                                  VerticalAlignment="Center"
                                  Source="{x:Bind ViewModel.SelectedWeapon.SubPropIcon, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.SelectedWeapon.SubPropIconVisibility, Mode=OneWay}" />
                            </StackPanel>
                            <TextBlock
                                Margin="0,6,0,0"
                                FontFamily="{StaticResource AppFontFamily}"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.SelectedWeapon.Source.Name, Mode=OneWay}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Opacity="0.7"
                                Text="{x:Bind ViewModel.SelectedWeapon.Description, Mode=OneWay}"
                                TextWrapping="Wrap" />
                          </StackPanel>
                        </Grid>
                      </Border>

                      <Border
                          Padding="16"
                          Style="{StaticResource BorderShimmerStyle}"
                          Visibility="{x:Bind ViewModel.WeaponGuideVisibility, Mode=OneWay}">
                        <StackPanel Spacing="16">
                          <TextBlock
                              x:Uid="WeaponRecommendHeader"
                              Style="{StaticResource AppBodyStrongTextBlockStyle}" />
                          <Pivot Margin="-16,-16,0,0">
                            <PivotItem x:Uid="WeaponGuideBuilds">
                              <ItemsControl
                                  Margin="16,8,0,0"
                                  ItemTemplate="{StaticResource WeaponAvatarTemplate}"
                                  ItemsSource="{x:Bind ViewModel.WeaponGuideBuilds, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate>
                                    <cwc:WrapPanel HorizontalSpacing="8" VerticalSpacing="8" />
                                  </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                              </ItemsControl>
                            </PivotItem>
                            <PivotItem x:Uid="WeaponGuideAbyss">
                              <ItemsControl
                                  Margin="16,8,0,0"
                                  ItemTemplate="{StaticResource WeaponAvatarTemplate}"
                                  ItemsSource="{x:Bind ViewModel.WeaponGuideAbyss, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate>
                                    <cwc:WrapPanel HorizontalSpacing="8" VerticalSpacing="8" />
                                  </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                              </ItemsControl>
                            </PivotItem>
                          </Pivot>
                        </StackPanel>
                      </Border>

                      <ctrl:WeaponLevelSlider
                          x:Name="LevelSlider"
                          HorizontalAlignment="Stretch" />

                      <Border
                          Padding="16"
                          Style="{StaticResource BorderShimmerStyle}"
                          Visibility="{x:Bind ViewModel.SelectedWeapon.CultivationVisibility, Mode=OneWay}">
                        <StackPanel Spacing="16">
                          <TextBlock
                              x:Uid="WeaponCultivationHeader"
                              Style="{StaticResource AppBodyStrongTextBlockStyle}" />
                          <ItemsControl
                              ItemTemplate="{StaticResource CultivationItemTemplate}"
                              ItemsSource="{x:Bind ViewModel.SelectedWeapon.CultivationMaterials, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <cwc:UniformGrid ColumnSpacing="8" Columns="3" RowSpacing="8" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                          </ItemsControl>
                        </StackPanel>
                      </Border>

                      <Border
                          Padding="16"
                          Style="{StaticResource BorderShimmerStyle}"
                          Visibility="{x:Bind ViewModel.SelectedWeapon.PassiveVisibility, Mode=OneWay}">
                        <StackPanel Spacing="16">
                          <TextBlock
                              Style="{StaticResource AppBodyStrongTextBlockStyle}"
                              Text="{x:Bind ViewModel.SelectedWeapon.PassiveName, Mode=OneWay}" />
                          <Pivot Margin="-16,-16,0,0">
                            <PivotItem x:Uid="WeaponRefine1">
                              <RichTextBlock
                                  Margin="16,8,0,0"
                                  FontFamily="{StaticResource AppFontFamily}"
                                  TextWrapping="Wrap"
                                  mihoyo:MiHoYo.Description="{x:Bind ViewModel.RefineDesc0, Mode=OneWay}" />
                            </PivotItem>
                            <PivotItem x:Uid="WeaponRefine2">
                              <RichTextBlock
                                  Margin="16,8,0,0"
                                  FontFamily="{StaticResource AppFontFamily}"
                                  TextWrapping="Wrap"
                                  mihoyo:MiHoYo.Description="{x:Bind ViewModel.RefineDesc1, Mode=OneWay}" />
                            </PivotItem>
                            <PivotItem x:Uid="WeaponRefine3">
                              <RichTextBlock
                                  Margin="16,8,0,0"
                                  FontFamily="{StaticResource AppFontFamily}"
                                  TextWrapping="Wrap"
                                  mihoyo:MiHoYo.Description="{x:Bind ViewModel.RefineDesc2, Mode=OneWay}" />
                            </PivotItem>
                            <PivotItem x:Uid="WeaponRefine4">
                              <RichTextBlock
                                  Margin="16,8,0,0"
                                  FontFamily="{StaticResource AppFontFamily}"
                                  TextWrapping="Wrap"
                                  mihoyo:MiHoYo.Description="{x:Bind ViewModel.RefineDesc3, Mode=OneWay}" />
                            </PivotItem>
                            <PivotItem x:Uid="WeaponRefine5">
                              <RichTextBlock
                                  Margin="16,8,0,0"
                                  FontFamily="{StaticResource AppFontFamily}"
                                  TextWrapping="Wrap"
                                  mihoyo:MiHoYo.Description="{x:Bind ViewModel.RefineDesc4, Mode=OneWay}" />
                            </PivotItem>
                          </Pivot>
                        </StackPanel>
                      </Border>

                      <Border
                          Padding="16"
                          Style="{StaticResource BorderShimmerStyle}"
                          Visibility="{x:Bind ViewModel.WeaponStoryVisibility, Mode=OneWay}">
                        <StackPanel Spacing="16">
                          <TextBlock
                              x:Uid="WeaponFlavorHeader"
                              Style="{StaticResource AppBodyStrongTextBlockStyle}" />
                          <TextBlock
                              IsTextSelectionEnabled="True"
                              Opacity="0.8"
                              Text="{x:Bind ViewModel.WeaponStory, Mode=OneWay}"
                              TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>

                    </StackPanel>
                  </ScrollViewer>
                </Grid>
              </SplitView.Content>
            </SplitView>
          </Border>
        </Border>
      </cwc:Case>

      <cwc:Case Value="Grid">
        <Border Margin="16,0,16,16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
          <Border Style="{StaticResource AcrylicBorderCardStyle}">
            <Grid Padding="16,16,4,-6">
              <StackPanel
                  VerticalAlignment="Center"
                  Visibility="{x:Bind ViewModel.EmptyStateVisible, Mode=OneWay}">
                <Image
                    Height="120"
                    Source="{StaticResource UI_EmotionIcon89}" />
                <TextBlock
                    x:Uid="WeaponEmptyHint"
                    Margin="0,5,0,21"
                    HorizontalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}" />
              </StackPanel>
              <GridView
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  ItemContainerStyle="{StaticResource LargeGridViewItemStyle}"
                  ItemTemplate="{StaticResource WeaponGridTemplate}"
                  ItemsSource="{x:Bind ViewModel.CurrentItems, Mode=OneWay}"
                  SelectionMode="Single"
                  SelectionChanged="OnWeaponSelectionChanged"
                  Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay}" />
            </Grid>
          </Border>
        </Border>
      </cwc:Case>

    </cwc:SwitchPresenter>

  </Grid>
</UserControl>
