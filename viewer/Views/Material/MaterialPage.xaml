<UserControl
    x:Class="Backpack.Viewer.Views.MaterialPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:vm="using:Backpack.Viewer.ViewModels">

  <Border Margin="16,8,16,16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
    <Border
        Background="{ThemeResource SystemControlAcrylicElementBrush}"
        BorderThickness="0"
        CornerRadius="{ThemeResource ControlCornerRadius}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Pivot
            x:Name="TabPivot"
            Grid.Row="0"
            Margin="8,0,0,0"
            ItemsSource="{x:Bind MaterialGroups, Mode=OneWay}"
            SelectionChanged="OnTabChanged">
          <Pivot.HeaderTemplate>
            <DataTemplate x:DataType="vm:MaterialGroupViewModel">
              <TextBlock Text="{x:Bind Header}" />
            </DataTemplate>
          </Pivot.HeaderTemplate>
          <Pivot.ItemTemplate>
            <DataTemplate x:DataType="vm:MaterialGroupViewModel">
              <Grid Visibility="Collapsed" />
            </DataTemplate>
          </Pivot.ItemTemplate>
        </Pivot>

        <ScrollViewer Grid.Row="1" Padding="8,4,8,8">
          <ItemsRepeater ItemsSource="{x:Bind CurrentItems, Mode=OneWay}">
            <ItemsRepeater.Layout>
              <UniformGridLayout
                  MinItemWidth="260"
                  MinColumnSpacing="8"
                  MinRowSpacing="8"
                  ItemsStretch="Fill" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="vm:MaterialViewModel">
                <Grid
                    Padding="10,8"
                    Style="{ThemeResource GridShimmerStyle}"
                    ColumnSpacing="10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Grid
                      Grid.Column="0"
                      Width="40"
                      Height="40"
                      VerticalAlignment="Center"
                      CornerRadius="6">
                    <Image Source="{x:Bind QualitySource}" Stretch="Fill" />
                    <Image Source="ms-appx:///Assets/Quality/UI_ImgSign_ItemIcon.png" Stretch="Fill" />
                    <Image
                        Width="36"
                        Height="36"
                        Source="{x:Bind IconSource, Mode=OneWay}"
                        Stretch="Uniform" />
                  </Grid>
                  <TextBlock
                      Grid.Column="1"
                      Style="{StaticResource AppBodyTextBlockStyle}"
                      Text="{x:Bind Name}"
                      TextTrimming="CharacterEllipsis"
                      VerticalAlignment="Center" />
                  <TextBlock
                      Grid.Column="2"
                      MinWidth="40"
                      Style="{StaticResource AppBodyStrongTextBlockStyle}"
                      Text="{x:Bind Count}"
                      TextAlignment="Right"
                      VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </ScrollViewer>
      </Grid>
    </Border>
  </Border>
</UserControl>
